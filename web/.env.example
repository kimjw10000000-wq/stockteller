# 관리자 로그인 (/admin) — Supabase Auth 계정 이메일 (쉼표로 여러 명 가능, .env.local·Vercel에만 설정)
ADMIN_EMAILS=your-admin@example.com

# 공개 회원가입/로그인 (이메일 OTP + 비밀번호)
# Supabase Dashboard → Authentication → Providers → Email 활성화
# 이메일 템플릿에 6자리 {{ .Token }} 포함
# Redirect URLs: http://localhost:3000/auth/callback , https://whyup.net/auth/callback

# 공시 요약은 Groq gpt-oss-20b (Vercel에 GROQ_API_KEY)

# SEC fair access: https://www.sec.gov/os/webmaster-faq#code-support
# company_tickers_exchange.json 동기화에도 동일 User-Agent 사용
SEC_USER_AGENT=YourProject/1.0 (you@example.com)

# Vercel Cron 보호 (disclosure-crawl, us-listed-sync)
# CRON_SECRET=

# 공개 사이트 URL (SEO: metadataBase, OG, sitemap). 예: https://whyup.net
NEXT_PUBLIC_SITE_URL=https://whyup.net

# Used by GitHub Actions / local crawler only (optional for Next runtime)
SITE_URL=https://your-deployment.vercel.app

# ========== 글로벌 시세 엔진 (npm run engine) ==========
# /api/us-day-gainers: Yahoo 후보 종목의 등락률·가격을 Finnhub /quote로 맞출 때도 사용(웹소켓 엔진과 동일 키).
FINNHUB_API_KEY=
ENGINE_US_SYMBOLS=AAPL,NVDA,TSLA
ENGINE_US_THRESHOLD_PCT=20

KIS_APP_KEY=
KIS_APP_SECRET=
KIS_MODE=real

ENGINE_KR_CODES=005930,000660
ENGINE_KR_PREV_CLOSE_JSON=
ENGINE_KR_THRESHOLD_PCT=15

JQUANTS_MAIL=
JQUANTS_PASSWORD=
ENGINE_JP_CODES=72030
ENGINE_JP_POLL_MS=30000
ENGINE_JP_THRESHOLD_PCT=15

ENGINE_UPSERT_MIN_MS=15000

# Vercel 등에서 Yahoo 서버 요청이 막힐 때 미국 급등 폴백 (https://www.alphavantage.co/support/#api-key)
# Vercel 대시보드에도 동일 이름으로 추가(Production 체크) 후 Redeploy
ALPHA_VANTAGE_API_KEY= PXX2X1PAQHPILWKL

# ========== Halt 데이터 소스 ==========
# nasdaq-rss | toss-vi | hybrid
# Toss 키가 있으면 기본값 hybrid (NASDAQ Halt + Toss VI/유의·종목명 보강)
# HALT_DATA_PROVIDER=hybrid

# ========== 토스증권 Open API ==========
# 발급: 토스증권 WTS → 설정 → Open API → client_id / client_secret
# 허용 IP 등록 필수(미등록 IP는 403).
#
# [로컬]
#   web/.env.local 에 아래 두 줄 설정 (Git 무시됨)
#
# [Vercel 프로덕션 — whyup.net]
#   1) Vercel Dashboard → stockteller → Settings → Environment Variables
#   2) 추가 (이름 정확히 동일, Production 체크):
#        TOSSINVEST_CLIENT_ID
#        TOSSINVEST_CLIENT_SECRET
#      (선택) TOSSINVEST_API_BASE_URL=https://openapi.tossinvest.com
#      (선택) HALT_DATA_PROVIDER=hybrid
#   3) 토스 Open API 허용 IP: Vercel은 출구 IP가 유동이라
#      고정 IP 프록시/VPS를 쓰거나, 우선 로컬 IP로 검증 후 배포하세요.
#   4) 저장 후 Redeploy (또는 npx vercel --prod)
TOSSINVEST_CLIENT_ID=
TOSSINVEST_CLIENT_SECRET=
# TOSSINVEST_API_BASE_URL=https://openapi.tossinvest.com

# ========== 주요지표 CPI/PPI ==========
# 예측치(컨센서스) — 발표 전 미리 설정
# INDICATOR_CPI_FORECAST=3.1
# INDICATOR_PPI_FORECAST=0.2
# 다음 발표 시각 (ISO UTC, 미국 동부 8:30 = UTC 12:30 또는 13:30 DST)
# INDICATOR_CPI_NEXT_RELEASE=2026-09-11T12:30:00.000Z
# INDICATOR_PPI_NEXT_RELEASE=2026-09-12T12:30:00.000Z
# 실제치는 BLS 공식 JSON API(api.bls.gov)에서 가져옵니다. VPS 불필요.
# 선택: 등록키(일 500회). 없으면 일 25회 제한 — 서버 캐시로 충분합니다.
# BLS_API_KEY=
# BLS_USER_AGENT=WhyupIndicators/1.0 (whyup.net; indicators@whyup.net)
# INDICATOR_POLL_MS=400
# 프로덕션 Mock API 허용(기본 비활성): INDICATOR_ALLOW_MOCK=1

# ========== Groq (공시 요약 · 지분희석 분류) ==========
# 값은 web/.env.local 과 Vercel Environment Variables 에만 넣기 (Git 금지)
# GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-20b

# ========== Together.ai (미세조정·비교용, 실시간 추론은 Groq) ==========
# 값은 web/.env.local 과 Vercel Environment Variables 에만 넣기 (Git 금지)
# TOGETHER_API_KEY=
# TOGETHER_BASE_URL=https://api.together.ai/v1
# TOGETHER_MODEL=Qwen/Qwen3.5-9B
