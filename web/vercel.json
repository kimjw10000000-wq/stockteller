{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "crons": [
    {
      "path": "/api/cron/disclosure-crawl",
      "schedule": "17 0 * * *"
    },
    {
      "path": "/api/cron/us-listed-sync",
      "schedule": "15 1 * * *"
    },
    {
      "path": "/api/cron/edgar-6k",
      "schedule": "7 2 * * *"
    }
  ],
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.whyup.net" }],
      "destination": "https://whyup.net/:path*",
      "permanent": true
    }
  ]
}
